# =============================================================================
# ARCA Homologation secrets — NAMES ONLY / placeholders
# Copy to .env.arca.homo.local (gitignored) and fill LOCALLY.
# NEVER commit real values. NEVER use NEXT_PUBLIC_ for these.
# NEVER paste secrets into chat.
# =============================================================================

ARCA_ENV=homologation

# 11-digit CUIT of the represented taxpayer (homologation)
ARCA_REPRESENTED_CUIT=00000000000

# Base64 of PEM private key and certificate (create locally — see docs)
ARCA_HOMO_PRIVATE_KEY_B64=
ARCA_HOMO_CERT_B64=

ARCA_WSAA_SERVICE=wsfe
ARCA_WSAA_URL=https://wsaahomo.afip.gov.ar/ws/services/LoginCms
ARCA_WSFE_URL=https://wswhomo.afip.gov.ar/wsfev1/service.asmx

# Explicit homologation point of sale (1..99998). Not discovered solely via FEParamGetPtosVenta.
ARCA_HOMO_PTO_VENTA=10

# Optional metadata (not a secret)
ARCA_CERT_ALIAS=CONTABILIUMHOMO01
