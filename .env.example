# =============================================================================
# Environment template — LOCAL / STAGING / PRODUCTION
# Staging and Production MUST use different Supabase projects.
# Never put SUPABASE_SERVICE_ROLE_KEY in NEXT_PUBLIC_* variables.
# =============================================================================

# local | staging | production
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# Branding (temporary identity — replace without code changes)
NEXT_PUBLIC_APP_NAME=Plataforma
NEXT_PUBLIC_APP_SHORT_NAME=App
NEXT_PUBLIC_APP_TAGLINE=Gestión contable inteligente
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@example.com

ARCA_ENV=disabled

# Homologation secrets live in gitignored .env.arca.homo.local
# See .env.arca.homo.example — never use NEXT_PUBLIC_ for ARCA secrets.
REHEARSAL_SUPABASE_PROJECT_REF=

# Supabase (anon key is public; service role is SERVER ONLY)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional project refs used to prevent staging/prod mix-ups
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
STAGING_SUPABASE_PROJECT_REF=staging-project-ref
PRODUCTION_SUPABASE_PROJECT_REF=production-project-ref
